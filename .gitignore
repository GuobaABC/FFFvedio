# 依赖
node_modules/

# 前端构建产物
frontend/dist/

# Wails 生成物（绑定与依赖指纹）
frontend/wailsjs/
frontend/package.json.md5

# Wails 构建产物
build/bin/

# 打包用的第三方依赖与工具（ffmpeg / NSIS / WebView2 引导程序），由 scripts/fetch-deps-windows.ps1 拉取
build/deps/
build/tools/
build/windows/installer/tmp/
build/_*

# go build 自动嵌入的 Windows 资源文件（由 scripts/build-windows.ps1 生成）
*.syso
*.exe

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
